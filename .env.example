# =============================================================================
#  Ozon B2B Engine v2.0 — environment template
#  Copy to `.env` and fill in. NEVER commit the filled-in `.env`.
#  Every value below is read through pydantic-settings; there is no hardcoded
#  credential anywhere in the source tree.
# =============================================================================

# --- Application --------------------------------------------------------------
OZON_APP_NAME="Ozon B2B Engine"
OZON_ENVIRONMENT=development           # development | staging | production
OZON_LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
OZON_API_HOST=0.0.0.0
OZON_API_PORT=8000
# Shared secret required in the `X-API-Key` header. Leave empty to disable auth
# (only acceptable when the service is bound to a private network).
OZON_API_KEY=

# --- Proxy pool ---------------------------------------------------------------
# Comma-separated list of upstream proxies. Both schemes are supported:
#   socks5://user:pass@host:port
#   http://user:pass@host:port
# Requirement: residential RU proxies, targeted at Moscow / Moscow oblast.
OZON_PROXY_POOL=
# Alternative to the inline list: path to a newline-delimited file of proxy URIs.
OZON_PROXY_POOL_FILE=
# Local HTTP-to-SOCKS5 bridge (Firefox/Gecko cannot authenticate SOCKS5 via URI).
OZON_PROXY_BRIDGE_HOST=127.0.0.1
OZON_PROXY_BRIDGE_PORT=0               # 0 = pick a free ephemeral port
OZON_PROXY_BRIDGE_MAX_THREADS=64
# Seconds a proxy stays benched after 403/429/503.
OZON_PROXY_COOLDOWN_SECONDS=180
# Sticky session TTL: how long one scrape chain keeps the same exit IP.
OZON_PROXY_STICKY_TTL_SECONDS=900
OZON_PROXY_HEALTHCHECK_URL=https://www.ozon.ru/
OZON_PROXY_HEALTHCHECK_TIMEOUT=15

# --- Anti-bot / transport -----------------------------------------------------
OZON_IMPERSONATE_PROFILE=chrome124      # curl_cffi TLS impersonation target
OZON_REQUEST_TIMEOUT=45
OZON_MAX_RETRIES=4
OZON_HTTP_CONCURRENCY=8                 # parallel curl_cffi requests per scrape
# Politeness: minimum delay between two HTTP calls on the same proxy (seconds).
OZON_MIN_REQUEST_DELAY=0.35
OZON_MAX_REQUEST_DELAY=1.10

# --- Browser (Camoufox) -------------------------------------------------------
OZON_BROWSER_HEADLESS=true
OZON_BROWSER_LOCALE=ru-RU
OZON_BROWSER_TIMEZONE=Europe/Moscow
OZON_BROWSER_NAV_TIMEOUT=60000          # ms
OZON_BROWSER_CHALLENGE_TIMEOUT=45       # s to wait for the WAF PoW to resolve
OZON_CAMOUFOX_EXECUTABLE=               # optional explicit path to the binary

# --- Session vault ------------------------------------------------------------
OZON_SESSION_DIR=./.sessions
OZON_COOKIE_FORMAT=json                 # json | netscape | both
# Refresh cookies this many seconds BEFORE they expire (spec: 5 minutes).
OZON_COOKIE_REFRESH_MARGIN=300
OZON_COOKIE_WATCH_INTERVAL=60

# --- Scraper tuning -----------------------------------------------------------
OZON_REVIEW_MAX_PAGES=500               # hard ceiling on pagination depth
OZON_REVIEW_PAGE_SIZE=25
OZON_REVIEW_TARGET_COVERAGE=1.0         # 1.0 = try to collect 100% of reviews
OZON_STOCK_PROBE_QUANTITY=990           # cart-method probe quantity
OZON_SERP_MAX_PAGES=15

# --- Storage ------------------------------------------------------------------
OZON_REDIS_URL=redis://localhost:6379/0
OZON_POSTGRES_DSN=postgresql+asyncpg://user:password@localhost:5432/ozon
OZON_CELERY_BROKER_URL=redis://localhost:6379/1
OZON_CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Downstream LLM (sentiment auto-replies) ---------------------------------
# The engine only BUILDS the payload; sending it is the caller's job. Provide a
# key here only if you enable the built-in dispatcher.
OZON_LLM_PROVIDER=none                  # none | anthropic | openai | gemini
OZON_LLM_API_KEY=
OZON_LLM_MODEL=

# --- Ozon Seller API (repricer push) -----------------------------------------
OZON_SELLER_CLIENT_ID=
OZON_SELLER_API_KEY=
